<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btn_enable_accessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enable_accessibility" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_key_capture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/capture_phone_keys" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_pass_to_android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pass_to_android" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/mapping_single" />

    <Spinner
        android:id="@+id/spinner_single"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mapping_double" />

    <Spinner
        android:id="@+id/spinner_double"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mapping_triple" />

    <Spinner
        android:id="@+id/spinner_triple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown" />

    <TextView
        android:id="@+id/label_press_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/press_window_label" />

    <SeekBar
        android:id="@+id/seek_press_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="280"
        android:min="0"
        android:progress="80" />

    <TextView
        android:id="@+id/label_debounce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/debounce_label" />

    <SeekBar
        android:id="@+id/seek_debounce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="160"
        android:min="0"
        android:progress="50" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/event_log_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_log" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_event_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace" />

</LinearLayout>
</ScrollView>